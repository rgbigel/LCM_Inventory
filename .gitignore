# Workspace_Inventory .gitignore
# PowerShell
*.ps1xml
*.log.temp

# Environment & OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary data / Scratchpad
Working/
scratch/
tmp/
*.tmp

# Historical & Deduplicated Archives
archive/
data/archives/

# Local Runtime Artifacts & Staging (Not Tracked in Git)
data/artifacts/
data/readiness/
data/reviews/
data/staging/
data/logs/lcm/
data/logs/lcm-internal/*.log
data/logs/lcm-internal/actions.jsonl

# VS Code local workspace state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json

# Canonical LCM rules are owned and tracked by Workspace_AI.
.agents/rules/

temp/
