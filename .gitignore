# Workspace_Inventory .gitignore
# PowerShell
*.ps1xml
*.log.temp

# Environment & OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary data / Scratchpad
Working/
scratch/
tmp/
*.tmp

# Historical & Deduplicated Archives
archive/
data/archives/

# Local Runtime Artifacts & Staging (Not Tracked in Git)
data/artifacts/
data/readiness/
data/reviews/
data/staging/

# VS Code local workspace state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json

# LCM Local Governance (physical rules tracked in Workspace_Inventory)
!.agents/
!.agents/rules/
!.agents/rules/*

temp/
